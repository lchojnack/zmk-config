+    default y
+    depends on ZMK_BLE
+    select BT_BAS if (!ZMK_SPLIT || (ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL))
+
+config ZMK_BATTERY_REPORTING_USB
+    bool "Report Battery Level over USB HID"
+    depends on ZMK_USB
+
+config ZMK_BATTERY_CHARGE_STATUS
+    bool "Report whether the battery is charging"
+    default y
+    depends on DT_HAS_ZMK_BATTERY_CHARGE_STATUS_ENABLED
+    select BT_BAS_BLS if BT_BAS
+    help
+      Reads the status output of the board's battery charger to report whether
+      the battery is charging, using the zmk,battery-charge-status devicetree
+      node. Without such a node there is no way to know, and the charge state
+      is reported as unknown.
+
+if ZMK_SPLIT_ROLE_CENTRAL
+
+config ZMK_BATTERY_REPORTING_SPLIT_FETCHING
+    bool "Fetch Peripheral Battery Level Info"
+    help
+      Adds internal support for fetching the battery levels from peripherals
+      and generating events in the ZMK eventing system.
+
+config ZMK_BATTERY_REPORTING_SPLIT_PROXY
+    bool "Proxy Battery Level Info"
+    default y if ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
+    help
+      Adds support for reporting the battery levels of connected split
+      peripherals through additional Battery Level services.
+
+config ZMK_BATTERY_REPORTING_SPLIT_REPORT_LOWEST_CHARGE
+    bool "Report the lowest charge of all batteries"
+    depends on ZMK_BATTERY_REPORTING_SPLIT_PROXY
+    default y
+    help
+      Report the lowest charge as the first battery level to hosts.
+
+endif # ZMK_SPLIT_ROLE_CENTRAL
+
 endif # ZMK_BATTERY_REPORTING
 
 config ZMK_IDLE_TIMEOUT
diff --git a/app/dts/bindings/zmk,battery-charge-status.yaml b/app/dts/bindings/zmk,battery-charge-status.yaml
new file mode 100644
index 00000000..8ed8ef4c
--- /dev/null
+++ b/app/dts/bindings/zmk,battery-charge-status.yaml
@@ -0,0 +1,53 @@
+# Copyright (c) 2026 The ZMK Contributors
+# SPDX-License-Identifier: MIT
+
+description: |
+  Reports whether the battery is charging, by reading the status output(s) of a
+  battery charger IC.
+
+  The charger ICs used on wireless keyboards expose one or two open drain status
+  pins that are pulled low to signal a state, so they are normally described
+  with GPIO_ACTIVE_LOW, and need a pull up if the board does not have one.
+
+  A charger with a single status pin, such as the MCP73831, cannot distinguish
+  "charge complete" from "no power applied":
+
+      charge_status {
+          compatible = "zmk,battery-charge-status";
+          charging-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+      };
+
+  A charger with a separate charge complete output, such as the TP4056, can:
+
+      charge_status {
+          compatible = "zmk,battery-charge-status";
+          charging-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+          full-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+      };
+
+compatible: "zmk,battery-charge-status"
+
+properties:
+  charging-gpios:
+    type: phandle-array
+    required: true
+    description: |
+      Charge status output of the charger, asserted while the battery is
+      charging. This is the STAT pin on a MCP73831, or the CHRG pin on a TP4056.
+
+  full-gpios:
+    type: phandle-array
+    required: false
+    description: |
+      Charge complete output of the charger, asserted once charging has
+      finished. This is the STDBY pin on a TP4056. Leave unset on chargers that
+      do not have a separate charge complete output, in which case a battery
+      that is not charging is reported as discharging.
+
+  debounce-ms:
+    type: int
+    default: 100
+    description: |
+      Time to wait for the status pins to settle before reporting a change.
+      Charger status outputs can toggle repeatedly as the charge current
+      approaches the termination threshold.
diff --git a/app/dts/bindings/zmk,battery-reporting.yaml b/app/dts/bindings/zmk,battery-reporting.yaml
new file mode 100644
index 00000000..fef9f23d
--- /dev/null
+++ b/app/dts/bindings/zmk,battery-reporting.yaml
@@ -0,0 +1,27 @@
+# Copyright (c) 2025 The ZMK Contributors
+# SPDX-License-Identifier: MIT
+
+description: |
+  Descriptions of each split battery of this keyboard.
+
+compatible: "zmk,battery-reporting"
+
+child-binding:
+  description: "Battery on a split part of the keyboard"
+  properties:
+    display-name:
+      type: string
+      required: false
+      description: |
+        A human-readable name for this battery. Defaults to readable form of CPF.
+    cpf:
+      type: int
+      required: false
+      description: |
+        Characteristic Presentation Format descriptor
+        for battery reporting
+    hidden:
+      type: boolean
+      required: false
+      description: |
+        Indicates if the battery charge level should be reported
