 #if IS_ENABLED(CONFIG_ZMK_BATTERY_REPORTING_USB)
 int zmk_usb_hid_send_battery_report_by_index(uint8_t battery_index) {
+    // A battery level must never wake a sleeping host. zmk_usb_hid_send_report()
+    // answers USB_DC_SUSPEND with usb_wakeup_request(), which is what makes a
+    // keypress wake the machine - but a 1% step, or a peripheral reporting 0 as it
+    // enters deep sleep, would wake it just the same. Drop the report instead; the
+    // host re-reads every battery over GET_REPORT when it resumes.
+    if (zmk_usb_get_status() == USB_DC_SUSPEND) {
+        return -EAGAIN;
+    }
+
